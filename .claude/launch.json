{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wsp-dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "wsp-dashboard-noauth",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true,
      "env": { "DISABLE_AUTH": "1", "NEXTAUTH_SECRET": "local-dev-only" }
    },
    {
      "name": "wsp-dashboard-auth-test",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true,
      "env": {
        "NEXTAUTH_SECRET": "local-dev-only",
        "GOOGLE_CLIENT_ID": "local-dev-only",
        "GOOGLE_CLIENT_SECRET": "local-dev-only",
        "WHARTON_ACCESS_PASSWORD": "local-dev-only-partner",
        "ALLOWED_EXTERNAL_EMAILS": "guest@example.com, Second.Guest@gmail.com",
        "ALLOWED_EXTERNAL_DOMAINS": "partner.example"
      }
    }
  ]
}
